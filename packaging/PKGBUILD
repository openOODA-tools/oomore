# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oomore-bin
_pkgname=oomore
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal POSIX-compliant paging utility for single-screen scrolling on restricted TTYs."
arch=('x86_64')
url="https://github.com/openOODA-tools/oomore"
license=('Apache-2.0')
depends=('glibc')
provides=('oomore')
conflicts=('oomore')
source_x86_64=("${url}/releases/download/v${pkgver}/oomore-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oomore-linux-x86_64" "${pkgdir}/usr/bin/oomore"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oomore-uninstall"
}
